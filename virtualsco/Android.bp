// Standalone vendor service registering android.hardware.audio.core.IModule/virtual.
//
// Drop this directory into your AOSP/BSP tree (e.g. vendor/aicaller/virtualsco or
// hardware/interfaces/audio/aidl/virtualsco) and build:
//     m android.hardware.audio.service-aidl.virtualsco
//
// It reuses AOSP's complete default audio HAL implementation (libaudioserviceexampleimpl) and its
// service defaults (aidlaudioservice_defaults), both from hardware/interfaces/audio/aidl/default,
// so the only new code is the virtual BT-SCO configuration + a tiny main. Building against the
// tree's own android.hardware.audio.core-V*-ndk is what makes this version-correct without us
// pinning a version by hand.

cc_binary {
    name: "android.hardware.audio.service-aidl.virtualsco",
    relative_install_path: "hw",
    vendor: true,
    // Mirrors android.hardware.audio.service-aidl.example (hardware/interfaces/audio/aidl/default).
    // The NDK backends stay shared because libaudioserviceexampleimpl itself links them via the
    // latest_*_ndk_shared defaults (static variants would collide with those). Built with an
    // Android 15 release config (ap3a, RELEASE_AIDL_USE_UNFROZEN=false) the unfrozen latest
    // version reports itself as the last frozen one — audio.core V2 / bluetooth.audio V4, the
    // fleet floor. On devices whose /vendor lacks these backends (e.g. SM-A566B keeps audio.core
    // only in /system/lib64), the vendor variants of the .so files are shipped in the Magisk
    // module's /vendor/lib64 overlay.
    defaults: [
        "aidlaudioservice_defaults",
        "latest_android_hardware_audio_core_sounddose_ndk_shared",
        "latest_android_hardware_audio_core_ndk_shared",
        "latest_android_hardware_bluetooth_audio_ndk_shared",
        "latest_android_media_audio_common_types_ndk_shared",
    ],
    static_libs: [
        "libaudioserviceexampleimpl",
    ],
    // libaudioserviceexampleimpl is static, so its own shared deps (incl. the Bluetooth module
    // code it always compiles in) must be linked here.
    shared_libs: [
        "android.hardware.bluetooth.audio-impl",
        "libaudio_aidl_conversion_common_ndk",
        "libbluetooth_audio_session_aidl",
        "liblog",
        "libmedia_helper",
        "libstagefright_foundation",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-DBACKEND_NDK",
    ],
    srcs: [
        "VirtualScoConfiguration.cpp",
        "main_virtual.cpp",
    ],
    init_rc: ["virtualsco.rc"],
    vintf_fragments: ["virtualsco.xml"],
}
