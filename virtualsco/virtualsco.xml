<!--
  VINTF manifest fragment declaring our extra AIDL audio module instance. servicemanager only lets a
  service register a DECLARED instance, and the framework's AIDL audio factory discovers modules via
  getDeclaredInstances("android.hardware.audio.core.IModule") — so this fragment is what makes
  IModule/virtual both registrable and enumerable, without modifying the vendor's own manifest.

  version = the android.hardware.audio.core interface version our binary implements. This device
  advertises 1-2, so 2 here. customize.sh templates this to the version detected on the target
  (see native/aidl/virtualsco/README.md) so one artifact adapts across devices.
-->
<manifest version="1.0" type="device">
    <hal format="aidl">
        <name>android.hardware.audio.core</name>
        <version>2</version>
        <fqname>IModule/virtual</fqname>
    </hal>
</manifest>
